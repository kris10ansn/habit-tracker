@HabitTracker.Api_HostAddress = http://localhost:5137

### List the current user's habits (ordered by Position)
GET {{HabitTracker.Api_HostAddress}}/api/habits
Accept: application/json

### Create a habit
# @name createHabit
POST {{HabitTracker.Api_HostAddress}}/api/habits
Content-Type: application/json

{
  "name": "Read",
  "polarity": "Positive"
}

### Get a single habit (paste an id from a create/list response)
GET {{HabitTracker.Api_HostAddress}}/api/habits/{{createHabit.response.body.$.id}}
Accept: application/json

### Update a habit
PUT {{HabitTracker.Api_HostAddress}}/api/habits/{{createHabit.response.body.$.id}}
Content-Type: application/json

{
  "name": "Read more",
  "polarity": "Positive",
  "position": 0
}

### Delete a habit
DELETE {{HabitTracker.Api_HostAddress}}/api/habits/{{createHabit.response.body.$.id}}

### Sync: merge the client's roster + month(s) and get the authoritative alive state back.
# Every timestamp is the client's own clock in epoch milliseconds UTC: `createdAt`, the `editedAt`
# merge key, and `deletedAt` (null while alive, the delete-time on a tombstone). The server's audit
# stamp is a separate field that never appears here. An editedAt more than five minutes ahead of the
# server clock is rejected with 400, so bump these when replaying this sample.
POST {{HabitTracker.Api_HostAddress}}/api/sync
Content-Type: application/json

{
  "habits": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Read",
      "polarity": "Positive",
      "position": 0,
      "createdAt": 1750600000000,
      "editedAt": 1750680000000,
      "deletedAt": null
    }
  ],
  "months": [
    {
      "month": "2026-06",
      "entries": [
        {
          "habitId": "11111111-1111-1111-1111-111111111111",
          "date": "2026-06-03",
          "outcome": "Success",
          "editedAt": 1750680001000,
          "deletedAt": null
        }
      ]
    }
  ]
}
